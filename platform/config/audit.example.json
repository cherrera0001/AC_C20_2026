{
  "audit_name": "Autoauditoría del laboratorio C4A",
  "auditor": "Cristóbal Herrera Jara",
  "person": "Cristóbal Herrera Jara",
  "target": "../..",
  "output_root": "../..",
  "normativas": ["ISO-27001", "LEY-21663", "LEY-21719", "NIST-800-218"],
  "detectors": ["all"],
  "sca": {
    "enabled": false,
    "engine": "auto",
    "allow_network": false,
    "timeout": 180,
    "max_packages": 200,
    "_ayuda": "engine: auto|osv-scanner|trivy|osv-api|off. 'auto' usa el binario local si existe; 'osv-api' consulta OSV.dev por red (requiere allow_network). Desactivado por defecto; si no hay motor, la CVE queda como revisión manual."
  },
  "scope": {
    "read_only": true,
    "max_file_bytes": 1500000,
    "exclude_dirs": [
      ".git", "node_modules", "dist", "build", ".turbo", ".next",
      "__pycache__", ".venv", "venv", "coverage",
      "01_plan", "02_evidencia", "03_hallazgos", "04_informe", "evidence", ".c4a",
      "triage", "reports"
    ],
    "exclude_globs": ["*.pdf"]
  }
}
