# Evidencia cruda: puede contener datos personales o sensibles.
# Se versiona cifrada y con hash; el crudo no entra a git por defecto.
evidence/*
!evidence/README.md
!evidence/.gitkeep
!evidence/MANIFEST.md
!evidence/*.sha256

# Secretos y credenciales
*.key
*.pem
*.p12
.env
.env.*

# Temporales
*.tmp
*.log
.DS_Store

# Estado interno de la plataforma C4A (ledger y dumps de hallazgos por corrida).
# Los entregables legibles viven en 02_evidencia/, 03_hallazgos/ y 04_informe/;
# una corrida se puede re-generar de forma reproducible desde la config.
.c4a/

# Cachés de Python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Informes generados contra objetivos EXTERNOS (p. ej. el repo VT o demos SCA).
# Son reproducibles desde su config; no engordan el repo del laboratorio.
reports/

# Material de clase: no se publica sin autorización (ver docs/ESTACION_LOCAL.md).
*.pdf

# Carpeta del agente (habilidades de Spec Kit, estado local de Claude Code).
# Excluida por recomendación de `specify init`: puede guardar credenciales o tokens.
# Excepción: las definiciones de agentes del equipo técnico se versionan (sin secretos).
.claude/*
!.claude/agents/

# Herramientas externas de apoyo a la auditoría, no forman parte de C4A.
.audit-tools/
